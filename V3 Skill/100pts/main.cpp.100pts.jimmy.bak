/**
 * Runs the user autonomous code. This function will be started in its own task
 * with the default priority and stack size whenever the robot is enabled via 
 * the Field Management System or the VEX Competition Switch in the autonomous
 * mode. Alternatively, this function may be called in initialize or opcontrol
 * for non-competition testing purposes.
 *
 * If the robot is disabled or communications is lost, the autonomous task
 * will be stopped. Re-enabling the robot will restart the task, not re-start it
 * from where it left off.
 */
 
    std::vector<lemlib::Pose> myPath = {
		{0, 0, 100},
		// {1.75, 15, 80},
		{2.219, 32.261, 0},
		// {0, 41.651, 60},
		{-6.762, 52.538, 0},
		{-6.762, 60, 0}
    };
	std::vector<lemlib::Pose> mySmoothPath = PathGenerator::generate(myPath, 80.0);

void test_path_generator() {
	// 4 waypoints: {x inches, y inches, heading degrees}
	// Draws a gentle S-curve across the field
	// Adjust these coords to match your actual field setup
	std::vector<lemlib::Pose> myPath = {
		{0,   0,  90},   // start, facing right
		{20,  20, 90},   // curve up-right
		{0,   40, 90},   // curve back left
		{20,  60, 90}    // end
	};

	std::vector<lemlib::Pose> smoothPath = PathGenerator::generate(myPath, 80.0);

	for (int i = 0; i < (int)smoothPath.size(); i++) {
		bool isLast = (i == (int)smoothPath.size() - 1);
		chassis.moveToPose(
			smoothPath[i].x,
			smoothPath[i].y,
			chassis.getPose().theta,
			500,
			{
				.maxSpeed = smoothPath[i].theta,
				.earlyExitRange = isLast ? 0.5f : 3.0f
			}
		);
		if (isLast) chassis.waitUntilDone();
	}
}

// PID turn test - set TEST_ANGLE to whichever angle you want to test
#define TEST_ANGLE 90   // change to 45 or 90 (or any angle) to test

void test_turn_pid() {
	chassis.turnToHeading(TEST_ANGLE, 2000);
	chassis.waitUntilDone();
}

