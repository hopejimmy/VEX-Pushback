// intake task
void auto_intake_task_fn(void*) {
    bool should_run = true;
    while (true) {
        if (pros::c::task_notify_take(true, 20)) {
            should_run = !should_run;
        }
        if (should_run) {
		intaking(600, 200);
        }
    }
}

void auto_intake2_task_fn(void*) {
    bool should_run = true;
    while (true) {
        if (pros::c::task_notify_take(true, 20)) {
            should_run = !should_run;
        }
        if (should_run) {
		intaking(600, 100,1);
        }
    }
}

// intake task
void auto_highscore_task_fn(void*) {
    bool should_run = true;
    while (true) {
        if (pros::c::task_notify_take(true, 20)) {
            should_run = !should_run;
        }
        if (should_run) {
		highscoring(600,200,200);
        }
    }
}

// intake task
void auto_midscore_task_fn(void*) {
    bool should_run = true;
    while (true) {
        if (pros::c::task_notify_take(true, 20)) {
            should_run = !should_run;
        }
        if (should_run) {
		midscoring(400, -50);
        }
    }
}


