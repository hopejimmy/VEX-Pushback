//set number of autons
const int NumberOfAutons = 2;//!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

//define auton names
const char* Autons[] = {
    "Skill 100pts         "
};




void AutonIncrease(){
    CurrentAuton ++;
    if(CurrentAuton > (NumberOfAutons-1)){
        CurrentAuton = 0;
    }
}

void AutonDecrease(){
    CurrentAuton --;
    if(CurrentAuton < 0){
        CurrentAuton = NumberOfAutons - 1;
    }
}




void intakecoast(){
	intakeF.set_brake_mode(pros::MotorBrake::coast);
	intakeM.set_brake_mode(pros::MotorBrake::brake);
	intakeB.set_brake_mode(pros::MotorBrake::brake);
}
 
// 结构体
struct Point {
    int front_dis;    // 前方距离
    int right_dis;    // 右侧距离  
    int left_dis;     // 左侧距离
};

/**
 * 获取多次采样滤波后的距离数据
 * @param SAMPLE_COUNT 采样次数（默认5）
 * @param SAMPLE_DELAY 采样间隔(ms)（默认50）
 * @return Point 各方向距离，若某方向从未有效且本次无效则返回-1
 */
Point get_distance_Pose(int SAMPLE_COUNT = 5, int SAMPLE_DELAY = 50) {
    // 为每个方向保存上次滤波值和初始化状态（跨调用保持）
    static struct {
        float last_val;
        bool initialized;
    } front_state = { -1.0f, false },
      right_state = { -1.0f, false },
      left_state  = { -1.0f, false };

    const float ALPHA = 0.3f;               // 滤波系数
    const float INVALID_MIN = 0.0f;          // 无效值下限
    const float INVALID_MAX = 2000.0f;       // 根据传感器量程调整

    // 辅助函数：对指定传感器进行多次采样，返回有效平均值和是否有效
    auto sample_average = [&](pros::Distance &sensor) -> std::pair<float, bool> {
        long sum = 0;
        int count = 0;
        for (int i = 0; i < SAMPLE_COUNT; i++) {
            int val = sensor.get_distance();
            if (val > INVALID_MIN && val < INVALID_MAX) {
                sum += val;
                count++;
            }
            pros::delay(SAMPLE_DELAY);  // 采样间隔
        }
        if (count > 0) {
            return { (float)sum / count, true };
        } else {
            return { -1.0f, false };    // 全部无效，标记为无效
        }
    };

    // 获取三个方向的采样平均值及有效标志
    auto [front_avg, front_valid] = sample_average(distanceFront);
    auto [right_avg, right_valid] = sample_average(distanceRight);
    auto [left_avg,  left_valid]   = sample_average(distanceLeft);

    // 滤波函数：输入平均值和有效标志，更新状态，返回滤波值（可能为-1）
    auto filter = [&](float avg, bool valid, auto& state) -> float {
        if (!valid) {
            // 本次采样全部无效：若已初始化则返回上次值，否则返回-1
            return state.initialized ? state.last_val : -1.0f;
        }
        // 有效值处理
        if (!state.initialized) {
            state.last_val = avg;        // 首次有效直接赋值
            state.initialized = true;
            return avg;
        }
        // 一阶低通滤波
        state.last_val = ALPHA * avg + (1.0f - ALPHA) * state.last_val;
        return state.last_val;
    };

    Point p;
    p.front_dis = static_cast<int>(filter(front_avg, front_valid, front_state));
    p.right_dis = static_cast<int>(filter(right_avg, right_valid, right_state));
    p.left_dis  = static_cast<int>(filter(left_avg, left_valid, left_state));
    return p;
}











float deccelarate=1;
bool reverse_complete=false;
bool low_complete=false;
bool mid_complete=false;
static int upper_ball_counter = 0;
static int mid_ball_counter = 0;


bool is_intake_jammed() {
    return (intakeM.get_current_draw() >= 2300);
}

bool is_intakeF_jammed() {
    return (intakeF.get_current_draw() >= 2500);
}

bool is_ball_preload(){
    return (dis_preload.get_distance() <= 100);

}



bool is_ball_ready(bool counter=true) {
if(counter){
    // 判断当前是否检测到球
    if (optical_top.get_proximity() >= 200) {
        // 检测到球，增加计数
        upper_ball_counter++;
 
        // 达到稳定次数后一直返回true
        if (upper_ball_counter >= 10) {
            return true;
        }
    } else {
        // 没检测到球，计数设为0
        if (upper_ball_counter > 0) {
            upper_ball_counter = 0;
        }
    }
    return false;
	} else {
		return (optical_top.get_proximity() >= 200);
	}
}

bool is_mid_full(float dis) {

    // 判断当前是否检测到球
    if (dis_roller.get_distance() <= dis) {
        // 检测到球，增加计数
        mid_ball_counter++;
 
        // 达到稳定次数后一直返回true
        if (mid_ball_counter >= 30) {
            return true;
        }
    } else {
        // 没检测到球，计数设为0
        if (mid_ball_counter > 0) {
            mid_ball_counter = 0;
        }
    }
    return false;
	
}




//Driver intake functions
void intaking(int velocity_front, int velocity_back, float back_dec=0.1){
intakeF.move_velocity(velocity_front);
    if(is_ball_ready()){
			optical_top.set_led_pwm(0);
        if(!is_intake_jammed()){
			if (is_mid_full(50)) {
			// intakeF.move_velocity(velocity_front);
            intakeM.move_velocity(0);
            intakeB.move_velocity(0);		
			}else{
            // intakeF.move_velocity(velocity_front);
            intakeM.move_velocity(velocity_back);
            intakeB.move_velocity(0);
			}
         } else {
            // intakeF.move_velocity(velocity_front);
            intakeM.move_velocity(-velocity_back);
            intakeB.move_velocity(0);
        }
    } else {
			optical_top.set_led_pwm(100);
        if(!is_intake_jammed()){
            // intakeF.move_velocity(velocity_front);
            intakeM.move_velocity(velocity_back);
            intakeB.move_velocity(velocity_back*back_dec);
        } else {
            // intakeF.move_velocity(velocity_front);
            intakeM.move_velocity(-velocity_back);
            intakeB.move_velocity(velocity_back*back_dec);
        }
    }
}

void intaking_reverse(int velocity_front, int velocity_back){

	while(!low_complete){
			intakeF.move_velocity(velocity_front*2);
			intakeM.move_velocity(velocity_back);
			intakeB.move_velocity(-velocity_back);
			pros::delay(300);
			low_complete=true;
		}
	    if(!is_intake_jammed()){
			intakeF.move_velocity(velocity_front);
			intakeM.move_velocity(velocity_back);
			intakeB.move_velocity(-velocity_back*0.2);
        } else {
			intakeF.move_velocity(velocity_front);
			intakeM.move_velocity(-velocity_back);
			intakeB.move_velocity(velocity_back*0.2);
        }


}


lemlib::Timer highscore_timer(500);
void highscoring(int velocity_front, int velocity_mid, int velocity_back){

	if(is_ball_preload()){
			highscore_timer.reset();
			while(is_ball_preload()&&!highscore_timer.isDone()){
			intakeF.move_velocity(-200);
			intakeM.move_velocity(-velocity_mid*0.5 *deccelarate);
			intakeB.move_velocity(velocity_back*deccelarate);
			}
	
	}
	else{

	}
 
		if(!(is_intake_jammed()&&is_intakeF_jammed())){
			intakeF.move_velocity(velocity_front);
			intakeM.move_velocity(velocity_mid*deccelarate);
			intakeB.move_velocity(velocity_back*deccelarate);
		} else {
			intakeF.move_velocity(velocity_front);
			intakeM.move_velocity(velocity_mid*deccelarate);
			intakeB.move_velocity(velocity_back*deccelarate);
		}

}

void midscoring(int velocity_front, int velocity_back){ 
	optical_preload.set_led_pwm(100);
	optical_top.set_led_pwm(100);
	if(is_ball_ready(false)&&!reverse_complete){
		while(!reverse_complete){
				intakeF.move_velocity(-300);
				intakeM.move_velocity(-100);
				intakeB.move_velocity(velocity_back*2);
				pros::delay(200);
				reverse_complete=true;
			}

	}
	if((optical_preload.get_hue() >= 190 && optical_preload.get_hue() <= 235 && dis_preload.get_distance() <= 120) ||mid_complete){

			intakeF.move_velocity(velocity_front);
			intakeM.move_velocity(-100);//-100
			intakeB.move_velocity(10); 
			mid_complete=true;

	} else {

		if(!is_intakeF_jammed()){
			intakeF.move_velocity(velocity_front);
			intakeM.move_velocity(70);
			intakeB.move_velocity(velocity_back);
			
		} else {
			intakeF.move_velocity(-velocity_front);
			intakeM.move_velocity(70);
			intakeB.move_velocity(velocity_back);
			pros::c::delay(50);
		}

	}

}









