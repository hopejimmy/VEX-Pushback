}


void minor_adjustment(int velocity, int timeout)
{

	chassis.arcade(velocity, 0);
	pros::c::delay(timeout);
	chassis.arcade(0, 0);
}


void skills100pts() {
	chassis.setBrakeMode(MOTOR_BRAKE_BRAKE);	
	chassis.setPose(0,0,90);//theta 90	
	hook.set_value(true);
	intakelift.set_value(false);
	// creat task
	pros::task_t auto_intake_task = 
	pros::c::task_create(auto_intake_task_fn, NULL, TASK_PRIORITY_DEFAULT,
											TASK_STACK_DEPTH_DEFAULT, "automatic intake task");
	pros::task_t auto_highscore_task = 
	pros::c::task_create(auto_highscore_task_fn, NULL, TASK_PRIORITY_DEFAULT,
											TASK_STACK_DEPTH_DEFAULT, "automatic highscore task");
	pros::task_t auto_midscore_task = 
	pros::c::task_create(auto_midscore_task_fn, NULL, TASK_PRIORITY_DEFAULT,
											TASK_STACK_DEPTH_DEFAULT, "automatic midscore task");

	pros::c::task_notify(auto_highscore_task); // pause task
	pros::c::task_notify(auto_midscore_task); // pause task

	//move to center goal
	chassis.moveToPose(23,2,75, 1500,{.lead=0.2,.maxSpeed=100,.minSpeed=50,.earlyExitRange=1});
	chassis.waitUntilDone();

	pros::c::delay(300);
	chassis.turnToHeading(-60, 600);
	chassis.waitUntilDone();
	pros::c::task_notify(auto_intake_task); // puase task
	simple_intaking(0,0,0);
	chassis.moveToPoint(33,-4,800,{.forwards=false,.maxSpeed=60,.earlyExitRange=2});
	chassis.waitUntilDone();
	chassis.swingToHeading(-42, DriveSide::LEFT, 200,{.maxSpeed=50});
	
	chassis.waitUntilDone();

	//score center goal
	highscore.set_value(true);
	simple_intaking(400,200,-150);
	chassis.arcade(-50,0);
	pros::c::delay(200);
	chassis.arcade(0, 0);


	chassis.setPose(0,0,chassis.getPose().theta);
	pros::delay(500);
	simple_intaking(0,0,0);


	//reset position

	chassis.moveToPoint(-32, 30, 800,{.maxSpeed=90,.minSpeed=90,.earlyExitRange=2});//17,7
	pros::c::delay(500);
	simple_intaking(600,200,200);
	chassis.moveToPoint(-32, 30, 800,{.maxSpeed=70,.minSpeed=20,.earlyExitRange=0.5});
	loader.set_value(true);	
	chassis.waitUntilDone();

	pros::c::delay(100);
	chassis.turnToHeading(0, 500);


	pros::c::task_notify(auto_intake_task); // resume task
	highscore.set_value(false);
	chassis.waitUntilDone();
	while(!dis_reach_target(510)){
	chassis.arcade(20, 0);}
	left_dis=distanceLeft.get_distance();//mm
	chassis.arcade(0, 0);
	pros::c::delay(100);
	chassis.turnToHeading(-91, 500);
	chassis.waitUntilDone();
	privious_X=(860-left_dis)/25.4;
	chassis.setPose(-33+privious_X,-32,chassis.getPose().theta+181);//+180
	pros::c::delay(100);

	//load 1
	chassis.moveToPoint(5,-31.5,800,{.maxSpeed = 45,.minSpeed=45 });
	chassis.waitUntilDone();
	chassis.arcade(-30,0);
	pros::delay(100);	
	chassis.arcade(30,0);	
	pros::delay(1400);


	
	//go to other side to score
	chassis.arcade(-60, 0);
	pros::c::delay(200);
	chassis.turnToHeading(210,300, {.maxSpeed=100,.minSpeed = 80, .earlyExitRange = 2});
	loader.set_value(false);
	chassis.moveToPoint(-35, -45,500, {.minSpeed = 80, .earlyExitRange = 3});

	pros::c::task_notify(auto_intake_task); // pause task
	simple_intaking(0,0,0);


	chassis.moveToPoint(-92, -47,  500, {.maxSpeed=120,.minSpeed = 100, .earlyExitRange = 2});
	chassis.waitUntilDone();

	tankmove_distanceToWall(850,800,100, 100);
	
	//chassis.setPose(0,0,270);//theta 270	
	chassis.resetLocalPosition();




	chassis.turnToHeading(180, 1000,{.maxSpeed=70});
	chassis.waitUntilDone();

	//chassis.moveToPose(9, 14, 270,1000,{.forwards=false,.lead=0.4,.maxSpeed=90,.minSpeed=40,.earlyExitRange=2});
	//chassis.waitUntilDone();
	minor_adjustment(-50,300);

	chassis.turnToHeading(270,1000);
	chassis.waitUntilDone();
	
	hook.set_value(false);
	minor_adjustment(-50,800);
	highscore.set_value(true);
	reverse_complete=false;
	pros::c::task_notify(auto_highscore_task); // resume task

	
	//chassis.arcade(-30, 0);
	loader.set_value(true);
	pros::c::delay(500);
	chassis.arcade(0,0);
	
	pros::c::delay(500);
	chassis.setPose(0,0,chassis.getPose().theta-270);
	
	pros::delay(500);
	pros::c::task_notify(auto_highscore_task); // pause task


	//load 2
	
	pros::c::task_notify(auto_intake_task); // resume task
	chassis.moveToPose(0.5,35,0.5,500,{.lead = 0.1,.maxSpeed = 80,.minSpeed=80});

	chassis.moveToPose(0.5,42,0.5,500,{.lead = 0.1,.maxSpeed = 40,.minSpeed=40});
	highscore.set_value(false);	
	chassis.waitUntilDone();
	chassis.arcade(-30,0);
	pros::delay(100);	
	chassis.arcade(45,0);	
	pros::delay(1400);

	//score 2
	hook.set_value(false);
	chassis.moveToPose(0, -5, 1, 900, {.forwards=false,.lead=0,.maxSpeed=75,.minSpeed = 40, .earlyExitRange = 0.3});
	minor_adjustment(-75, 300);
	chassis.waitUntilDone();
	pros::c::task_notify(auto_intake_task); // pause task
	highscore.set_value(true);


	reverse_complete=false;
	pros::c::task_notify(auto_highscore_task); // resume task

	loader.set_value(false);
	chassis.waitUntilDone();
	pros::c::delay(200);
	chassis.arcade(-25,0);
	pros::delay(500);
	chassis.arcade(0,0);
	pros::c::delay(100);
	if(fabs(chassis.getPose().theta)>2){
	chassis.setPose(0,0,chassis.getPose().theta);	
	} 
	else{
	chassis.setPose(0,0,0);	
	}
	pros::delay(1000);
	chassis.waitUntilDone();
	pros::c::task_notify(auto_highscore_task); // pause task

	simple_intaking(0,200,200);
	


	//score low goal

	chassis.turnToHeading(95,800);

	chassis.moveToPoint(19.16,-2.3, 700,{.maxSpeed=60,.minSpeed=40});
	simple_intaking(600,0,0);
	chassis.waitUntilDone();
	loader.set_value(true);
	pros::delay(500);

	chassis.moveToPose(35.3, -19, 132,1000,{.lead=0,.maxSpeed=60,.minSpeed=50});
	pros::delay(200);
	loader.set_value(false);
	chassis.waitUntilDone();
	intakelift.set_value(true);
	pros::delay(50);
	simple_intaking(-300,-200,-10);
	/*
	pros::c::delay(1500);
	chassis.arcade(-60, 5);
	pros::c::delay(300);



		
	//clear opposite parking zone
	
	chassis.moveToPose(18 ,33,80, 1800,{.forwards=false,.lead=0.1,.maxSpeed=80,.earlyExitRange=2});
