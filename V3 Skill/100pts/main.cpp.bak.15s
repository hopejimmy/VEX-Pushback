// 核心状态变量
static bool isReversingForBlue = false;          // 是否正在为蓝球执行反转
static uint32_t reverseStartTime = 0;            // 反转开始的时刻
static const uint32_t REVERSE_DURATION = 200;    // 蓝球反转持续时间（毫秒）

void highscoring_ColourSort(int velocity_front, int velocity_back) {
    bool jammed = is_intake_jammed();
    uint32_t currentTime = pros::millis();
    
    // 1. 优先处理卡球：所有滚轮立即反转清障
    if (jammed) {
        intakeF.move_velocity(velocity_front);
        intakeM.move_velocity(-velocity_back);
        intakeB.move_velocity(velocity_back);
        isReversingForBlue = false; // 重置蓝球状态
        return;
    }
    
    // 2. 如果正处于蓝球反转的计时期间
    if (isReversingForBlue) {
        // 保持后滚轮反转
        intakeF.move_velocity(velocity_front);
        intakeM.move_velocity(-velocity_back*0.2); // 中滚轮轻微反转防止卡住
        intakeB.move_velocity(-velocity_back);
        
        // 检查计时是否结束
        if (currentTime - reverseStartTime >= REVERSE_DURATION) {
            isReversingForBlue = false; // 计时结束，恢复正常状态
        }
        return; // 在反转期间，不检测新球
    }
    
    // 3. 正常状态：检测并处理新球
    float hue = optical_top.get_hue();
    
    if ((hue >= 0 && hue <= 30) || (hue >= 330 && hue <= 360)) {
        // 红球：所有滚轮正转
        intakeF.move_velocity(velocity_front);
        intakeM.move_velocity(velocity_back);
        intakeB.move_velocity(velocity_back);
    } 
    else if (hue >= 180 && hue <= 260) {
        // 蓝球：开始计时反转流程
        reverseStartTime = currentTime;  // 记录开始时间
        isReversingForBlue = true;       // 进入反转状态
        
        // 启动反转
        intakeF.move_velocity(velocity_front);
        intakeM.move_velocity(-velocity_back*0.2); // 中滚轮轻微反转防止卡住
        intakeB.move_velocity(-velocity_back);
    } 
    else {
        // 未识别到有效颜色：默认正转准备接球
        intakeF.move_velocity(velocity_front); 
        intakeM.move_velocity(velocity_back);
        intakeB.move_velocity(velocity_back);
    }
}


 

float DTkp = 0.85;
bool highscore_con=false;
bool intake_lift_con=false;
bool hook_con=false;
bool loader_con=false;
bool odom_con=false;


 
void opcontrol() {

	chassis.setBrakeMode(MOTOR_BRAKE_COAST);
    intakecoast();


	hook_con=true;

//Drivetrain & Intake Controll  
pros::Task DrivetrainTask{[&]() {

	while (true) {
		int leftY = controller.get_analog(pros::E_CONTROLLER_ANALOG_LEFT_Y);
		int rightX = controller.get_analog(pros::E_CONTROLLER_ANALOG_RIGHT_X);
		chassis.arcade(leftY, rightX*DTkp);
		Odom.set_value(odom_con);
		highscore.set_value(highscore_con);
		intakelift.set_value(intake_lift_con);

        pros::delay(10);
	}
}};

pros::Task IntakeTask{[&]() {

	while (true) {
		if (controller.get_digital(pros::E_CONTROLLER_DIGITAL_R1)) {//intake
			intaking(600, 200);
			highscore_con=false;
			odom_con=true;
		} else if (controller.get_digital(pros::E_CONTROLLER_DIGITAL_R2)) {//reverse
			intaking_reverse(-600, -150);
		} else if (controller.get_digital(pros::E_CONTROLLER_DIGITAL_L1) ) {//long goal
			highscore_con=true;
			highscoring(600,200,200);


		} else if (controller.get_digital(pros::E_CONTROLLER_DIGITAL_L2)) {//mid high
			reverse_complete=false;
			highscore_con=true;
			midscoring(400, -200);
			
			while(controller.get_digital(pros::E_CONTROLLER_DIGITAL_L2)==1)	{}			
		} 
		
		else {
			intakeF.move_velocity(0); 
			intakeM.move_velocity(0);
			intakeB.move_velocity(0);

		}

        pros::delay(10);
	}

}};

//Pnumatics Control
pros::Task buttonTask{[&]() {
while(true){

//loader
if(controller.get_digital(pros::E_CONTROLLER_DIGITAL_X)){
	if(loader_con==false){
		loader_con=true; 
	}else{
		loader_con=false;
	}
while(controller.get_digital(pros::E_CONTROLLER_DIGITAL_X))	{}
}
loader.set_value(loader_con);


//pneumatics hook
if(controller.get_digital(pros::E_CONTROLLER_DIGITAL_Y)){
	if(hook_con==false){
		hook_con=true;
	}else{
		hook_con=false;
	}
while(controller.get_digital(pros::E_CONTROLLER_DIGITAL_Y))	{}
}
hook.set_value(hook_con);


}
}};


