std::string color;
std::string current_color;
std::string red = "Red";
std::string blue = "Blue";







void get_allience_color(){
	optical_top.set_led_pwm(100);
	float hue = optical_top.get_hue();
	if ((hue >= 0 && hue <= 30) || (hue >= 330 && hue <= 360)) {
		color = red;
		optical_top.set_led_pwm(0);
	} 
	else if (hue >= 170 && hue <= 240) {
		color = blue;
		optical_top.set_led_pwm(0);
	}
	else {
		color = "Unknown";
		optical_top.set_led_pwm(0);
	}
	
}



bool is_correct_color(){

	float hue = optical_top.get_hue();
	if ((hue >= 0 && hue <= 30) || (hue >= 330 && hue <= 360)) {
		current_color = red; 
		optical_top.set_led_pwm(0);
	} 
	else if (hue >= 170 && hue <= 240) {
		current_color = blue;
		optical_top.set_led_pwm(0);
	}

	if (current_color == color){
		return true;
	} else {
		return false;
	
	}

}



bool comp_mode=false;


// Auton Selector
int CurrentAuton = 0;
const int NumberOfAutons = 6; // The number of Autons
std::array<std::string, NumberOfAutons> Autons = {
    "Auton One",
    "Auton Two",
    "Auton Three",
    "Auton Four",
    "Auton Five",
	"Skills"
};
void AutonIncrease(){
    CurrentAuton ++;
    if(CurrentAuton > NumberOfAutons){
        CurrentAuton = 0;
    }
}
void AutonDecrease(){
    CurrentAuton --;
    if(CurrentAuton < 0){
        CurrentAuton = NumberOfAutons;
    }
}


void intakecoast(){
	intakeB.set_brake_mode(pros::MotorBrake::brake);
	intakeF.set_brake_mode(pros::MotorBrake::coast);
	intakeM.set_brake_mode(pros::MotorBrake::coast);
}


float roll_degree;
bool reverse_complete=false;
static int mid_ball_counter = 0;
static const int REQUIRE_STABLE_COUNT = 20;  //连续20次检测到球

bool is_intake_jammed() {
    return (intakeM.get_current_draw() >= 2200);
}

bool is_ball_ready(){
    return (optical_top.get_proximity() >= 200);
}



bool is_mid_full(float dis) {
    // 判断当前是否检测到球
    if (dis_roller.get_distance() <= dis) {
        // 检测到球，增加计数
        mid_ball_counter++;
        
        // 达到稳定次数后一直返回true
        if (mid_ball_counter >= REQUIRE_STABLE_COUNT) {
            return true;
        }
    } else {
        // 没检测到球，计数设为0
        if (mid_ball_counter > 0) {
            mid_ball_counter = 0;
        }
    }
    return false;
	pros::c::delay(100);
}


int midRollerState() {
    return is_mid_full(100) ? 0 : 1;
}


//Driver intake functions
void intaking(int velocity_front, int velocity_back){
	optical_top.set_led_pwm(100);
    if(is_ball_ready()){
		optical_top.set_led_pwm(0);
        if(!is_intake_jammed()){
            intakeF.move_velocity(velocity_front);
            intakeM.move_velocity(velocity_back * midRollerState());
            intakeB.move_velocity(0);
        } else {
            intakeF.move_velocity(velocity_front);
            intakeM.move_velocity(-velocity_back * midRollerState());
            intakeB.move_velocity(0);
        }
    } else {
        if(!is_intake_jammed()){
            intakeF.move_velocity(velocity_front);
            intakeM.move_velocity(velocity_back);
            intakeB.move_velocity(velocity_back);
        } else {
            intakeF.move_velocity(velocity_front);
            intakeM.move_velocity(-velocity_back);
            intakeB.move_velocity(velocity_back);
        }
    }
}

void intaking_reverse(int velocity_front, int velocity_back){

	intakeF.move_velocity(velocity_front);
	intakeM.move_velocity(velocity_back*1.5);
	intakeB.move_velocity(velocity_back);

}

void highscoring(int velocity_front, int velocity_mid, int velocity_back){
		if(!is_intake_jammed()){
			intakeF.move_velocity(velocity_front);
			intakeM.move_velocity(velocity_mid);
			intakeB.move_velocity(velocity_back);
		} else {
			intakeF.move_velocity(velocity_front);
			intakeM.move_velocity(-velocity_mid);
			intakeB.move_velocity(velocity_back);
		}
}

void midscoring(int velocity_front, int velocity_back){ 

	if(is_ball_ready()){
	while(!reverse_complete){
			intakeF.move_velocity(-velocity_front);
			intakeM.move_velocity(-velocity_front*0.33);
			intakeB.move_velocity(velocity_back);
			pros::delay(200);
			reverse_complete=true;
		}

}
			intakeF.move_velocity(velocity_front);
			intakeM.move_velocity(150);
			intakeB.move_velocity(velocity_back);
}



// intake task
void auto_intake_task_fn(void*) {
    bool should_run = true;
    while (true) {
        if (pros::c::task_notify_take(true, 20)) {
            should_run = !should_run;
        }
        if (should_run) {
		intaking(600, 200);
        }
    }
}



/**
 * Runs initialization code. This occurs as soon as the program is started.
 *
 * All other competition modes are blocked by initialize; it is recommended
 * to keep execution time for this mode under a few seconds.
 */


void initialize() {
	pros::lcd::initialize();
    chassis.calibrate(); 


	verticalEnc.set_position(0);
	horizontalEnc.set_position(0);
	//chassis original point
	chassis.setPose(0,0,0);
	intakecoast();
	//print position
	if(!comp_mode){
	controller.print(0, 0,"X: %.3f", chassis.getPose().x); // x
	pros::delay(50);
    controller.print(1,0, "Y: %.3f", chassis.getPose().y); // y
	pros::delay(50);
    controller.print(2,0, "Theta: %.3f", chassis.getPose().theta); // heading
	pros::delay(100); 
	pros::Task screenTask_regular{[&]() {
		while(!comp_mode){
			controller.print(0, 0,"X: %.3f", chassis.getPose().x); // x
			pros::delay(50);
            controller.print(1,0, "Y: %.3f", chassis.getPose().y); // y
			pros::delay(50);
            controller.print(2,0, "Theta: %.2f", chassis.getPose().theta); // heading
			pros::delay(50);
            controller.print(2,13, "dis:%d",distanceFront.get_distance());
			pros::delay(150);
		}
  	}};		
	}else{

    controller.print(0,0, "Theta: %.3f", chassis.getPose().theta); // heading
	pros::delay(100); 
	pros::Task screenTask_Comp_mode{[&]() {
		while(comp_mode){
            controller.print(0,0, "Theta: %.2f", chassis.getPose().theta); // heading
			pros::delay(100);
		}
  	}};			
	}


}

