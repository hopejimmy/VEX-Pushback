void Left4_3_hook(){
	// creat intake task
	pros::task_t auto_intake_task = 
	pros::c::task_create(auto_intake_task_fn, NULL, TASK_PRIORITY_DEFAULT,TASK_STACK_DEPTH_DEFAULT, "automatic intake task");

	chassis.setPose(0,0,-90);
    chassis.setBrakeMode(MOTOR_BRAKE_BRAKE);


	chassis.moveToPose(-23,-7.5,-150,1500,{.lead=0.2,.maxSpeed = 80,.minSpeed = 30,.earlyExitRange=0.5});
	pros::c::delay(600);
	loader.set_value(true);
	chassis.waitUntilDone();
	pros::c::delay(200);
	chassis.turnToHeading(-230, 500);
	//center goal
	chassis.moveToPoint(-37,4.2,900,{.forwards = false,.maxSpeed = 70,.minSpeed = 50});
    pros::delay(700);
	
	pros::c::task_notify(auto_intake_task); // pause task
	auto_intaking(600,-150,-200);
	pros::c::delay(100);
	highscore.set_value(true);
	auto_intaking(600,200,-100);
	pros::delay(1500);


	//loader

	chassis.moveToPose(-3, -27, -227, 500,{.lead=0,.maxSpeed=50,.minSpeed = 40,.earlyExitRange =0.5});
	
	chassis.moveToPose(-3, -27, -230, 1200,{.lead=0.2,.maxSpeed=100,.minSpeed = 80,.earlyExitRange =0.5});	
	highscore.set_value(false);
	pros::c::task_notify(auto_intake_task); // resume task

	chassis.swingToHeading(-270, lemlib::DriveSide::LEFT,400,{.maxSpeed=60});
	chassis.waitUntilDone();

	chassis.moveToPose(15,-31,-270,1000,{.lead = 0,.maxSpeed = 55,.minSpeed=55 });
	chassis.waitUntilDone();

	//score long goal
	chassis.moveToPoint(-20,-32,1100,{.forwards = false,.maxSpeed = 90,.minSpeed=80,.earlyExitRange=0.5});
	pros::delay(700);
	loader.set_value(false);
	highscore.set_value(true);
	pros::c::task_notify(auto_intake_task); // pause task
	auto_intaking(600,200,200);
	
	chassis.waitUntilDone();
	chassis.arcade(-40, 0);
	pros::delay(200);
	chassis.arcade(0, 0);
	chassis.setPose(0,0,chassis.getPose().theta+270);
	pros::delay(1000);
	

	//hook
	chassis.turnToHeading(-75, 600);
	chassis.waitUntilDone();
	auto_intaking(0,0,0);
	chassis.swingToHeading(-8,lemlib::DriveSide::RIGHT, 500);
	highscore.set_value(false);
	hook.set_value(false);
	chassis.waitUntilDone();
	chassis.moveToPose(-9, -18,-2, 800,{.forwards=false,.lead=0.2,.maxSpeed=70,.minSpeed=60});

	chassis.waitUntilDone();
	pros::c::delay(200);
	chassis.turnToHeading(30, 300,{.maxSpeed=50});
	chassis.setBrakeMode(pros::E_MOTOR_BRAKE_HOLD);
	Odom.set_value(true);
	pros::c::delay(9000);
}


void Right3_4_hook(){
	hook.set_value(true);
	// creat intake task
	pros::task_t auto_intake_task = 
	pros::c::task_create(auto_intake_task_fn, NULL, TASK_PRIORITY_DEFAULT,TASK_STACK_DEPTH_DEFAULT, "automatic intake task");

	chassis.setPose(0,0,0);
	chassis.setBrakeMode(MOTOR_BRAKE_BRAKE);

	chassis.moveToPose(3,-25,0,500,{.forwards = false,.lead=0,.minSpeed=60,.earlyExitRange = 5});
	chassis.moveToPose(3,-25,0,400,{.forwards = false,.lead=0,.maxSpeed=40,.earlyExitRange = 5});
	pros::c::delay(200);
	loader.set_value(true);	
	chassis.waitUntilDone();
	

	chassis.turnToHeading(-88,400);

	//loading


	chassis.moveToPose(-10.5,-29.5,-87,1050,{.lead = 0,.maxSpeed = 50,.minSpeed=50});
	chassis.waitUntilDone();
	chassis.moveToPose(23,-31,-87 ,1000,{.forwards = false,.lead=0.1,.maxSpeed = 100,.minSpeed=80});

	//score long goal
	pros::delay(800);
	
	highscore.set_value(true);
	pros::c::task_notify(auto_intake_task); // pause task
	auto_intaking(600,200,200);
	chassis.waitUntilDone();
	loader.set_value(false);
	chassis.arcade(-20, 0);
	pros::delay(500);
	chassis.arcade(0, 0);	
	// chassis.setPose(0,0,chassis.getPose().theta+90);
	pros::delay(300);

	//mid goal
	auto_intaking(600,-200,100);
	chassis.turnToHeading(10,700);
	chassis.waitUntilDone();
	highscore.set_value(false);
	chassis.moveToPoint(24,-10.7,800,{.maxSpeed = 70,.minSpeed = 30});
	pros::c::delay(300);
	loader.set_value(true);
	chassis.waitUntilDone();

	chassis.moveToPose(40,9,45, 1000,{.lead=0.2,.maxSpeed = 60,.minSpeed = 30,.earlyExitRange = 0.5});
	pros::c::delay(100);
	loader.set_value(false);
	chassis.waitUntilDone();
	intakelift.set_value(true);
	auto_intaking(-400, -200, 0);
	pros::c::delay(800);
	intakelift.set_value(false);

	//hook
	chassis.moveToPose(22,-15,93, 1200,{.forwards=false,.lead=0,.maxSpeed = 90,.minSpeed = 30,.earlyExitRange = 5});	
	chassis.waitUntilDone();

	hook.set_value(false);
	chassis.moveToPoint(35,-22,600,{.maxSpeed = 80,.minSpeed = 60});
	chassis.waitUntilDone();
	chassis.turnToHeading(60, 300);
	Odom.set_value(true);
	pros::c::delay(9000);






}	




