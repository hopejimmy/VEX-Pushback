float parking_cycle=0;
bool parking_direction=false;

bool dis_reach_target(int dis){
	return(distanceFront.get_distance()<=dis);
}


void auto_intaking(int velo_front,int velo_mid,int velo_back){
	intakeF.move_velocity(velo_front);
	intakeM.move_velocity(velo_mid);
	intakeB.move_velocity(velo_back);
}


void shaking(int cycle){
	for(int i=0;i<cycle;i++){
		chassis.arcade(-40,0);
		pros::delay(200);	
		chassis.arcade(50,0);	
		pros::delay(300);	
	}
}

void wiggle(float speed,int delay_time,int cycle){
	for(int i=0;i<cycle;i++){
		chassis.tank(speed,-speed);
		pros::delay(delay_time);
		chassis.tank(-speed,speed);
		pros::delay(delay_time);
	}
}

